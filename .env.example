# Copier en .env.local (gitignoré via *.local) et remplir avec les vraies
# valeurs LOCALES données par `npx supabase status` après `npx supabase start`.
#
# Variables FRONT autorisées — uniquement celles-ci. Ne JAMAIS ajouter ici une
# clé secrète (sb_secret_…) ou service_role : Vite les inline en clair dans le
# bundle envoyé au navigateur. La clé secrète vit uniquement côté Edge
# Function (supabase/functions/*/.env.local, jamais commité).

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
